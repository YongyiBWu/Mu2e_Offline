#
# Trace the MCTrajectories of particles that reach a set of StepPointMCs (pre
# filtered at some VD, further PDGID filter available),
# following the genealogy back to the primary, and write them to a ROOT TTree.
# Modelled on Offline/Print/fcl/printMCTrajectory.fcl (the text-dump reference).
#
# Edit StepPointMCsTag / SimParticlemvTag / MCTrajectoriesTag / pdgIDs to match the input file.
# Run as: mu2e -c Offline/STMMC/fcl/ParticleTracer.fcl -s/S <file>.art/catalog (-n 10)
#

#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"

process_name : ParticleTracer

source : {
  module_type : RootInput
  maxEvents   : -1
}

services : {
  message : @local::default_message
  TFileService : { fileName : @nil }
  GlobalConstantsService : {
    inputFile : "Offline/GlobalConstantsService/data/globalConstants_01.txt"
  }
}

physics : {
  analyzers : {
    particleTracer : {
      module_type      : ParticleTracer
      StepPointMCsTag  : "compressDetStepMCsSTM:"   # StepPointMCs to seed from
      SimParticlemvTag : "compressDetStepMCsSTM:"   # SimParticleCollection
      MCTrajectoriesTag : "g4run"                   # MCTrajectoryCollection
      # pdgIDs           : [ 2112 ]                  # neutron; a sequence, add more as needed
      # keepAllPdgIds    : false
      pdgIDs           : []                  # neutron; a sequence, add more as needed
      keepAllPdgIds    : true
      keepParticlesWithPositivePz : false           #false = keep all, true = only keep +pz
    }
  }

  e1        : [ particleTracer ]
  end_paths : [ e1 ]
}

services.TFileService.fileName : "/exp/mu2e/data/users/yongyiwu/MDC2025ab/datasets/MDC2025/rootfiles/EleBeamToVD101All.root"
